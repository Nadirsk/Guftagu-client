# Guftagu admin panel — environment
#
# Copy to `.env` and adjust. Every variable must start with VITE_, or Vite will not expose
# it to the client bundle.
#
# WARNING: everything in here is compiled into the JavaScript that ships to the browser.
# There are no secrets in this file and there must never be one. Admin API credentials are
# exchanged for a bearer token at runtime, never built in.

# ---------------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------------

# Where the app sends requests. Relative by default so the browser stays on one origin:
# in dev the Vite proxy forwards /api to the backend, and in production nginx serves the
# panel and the API from the same vhost. Both cases mean no CORS configuration at all.
#
# Set an absolute URL (https://api.guftagu.com/api/v1) only when the panel is genuinely
# served from a different origin than the API — and then the backend needs matching CORS.
VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api to. Dev only; ignored in a build.
#
# 8001, not 8000: `php artisan serve --port=8001`, because 8000 belongs to the old FastAPI
# app on this machine.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# ---------------------------------------------------------------------------------------
# Dev server
# ---------------------------------------------------------------------------------------

# The port is pinned rather than auto-incremented: Vite's default is to move to the next
# free port, which leaves a stale tab pointed at a dead one and a "connection refused" that
# looks like an API failure.
VITE_DEV_PORT=5173
